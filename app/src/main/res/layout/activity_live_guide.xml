<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#090607">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="KOLA IPTV  •  LIVE TV GUIDE" android:textColor="@android:color/white" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CREATED BY MHILL KABASHI" android:textColor="#E53935" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:layout_width="210dp" android:layout_height="match_parent" android:orientation="vertical" android:background="#D9151012" android:padding="7dp">
                <TextView android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:text="CATEGORIES" android:textColor="#E53935" android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/categories" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout android:layout_width="360dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:orientation="vertical" android:background="#D9151012" android:padding="7dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/channelCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Channels" android:textColor="@android:color/white" android:textStyle="bold"/>
                    <Button android:id="@+id/favoritesButton" android:layout_width="105dp" android:layout_height="36dp" android:background="@drawable/channel_selector" android:text="★ FAVORITES" android:textColor="@android:color/white" android:textSize="10sp"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <androidx.media3.ui.PlayerView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.58" android:background="#000000" app:use_controller="false" app:resize_mode="fit"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="0.42" android:background="#E0181114" android:orientation="vertical" android:padding="12dp">
                    <TextView android:id="@+id/programTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select a channel" android:textColor="@android:color/white" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/programTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#F04A45" android:textSize="13sp" android:textStyle="bold"/>
                    <ProgressBar android:id="@+id/programProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:max="100"/>
                    <TextView android:id="@+id/programDescription" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:maxLines="3" android:textColor="#D0D0D0" android:textSize="12sp"/>
                    <TextView android:id="@+id/nextPrograms" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EPG will appear here" android:textColor="@android:color/white" android:textSize="12sp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="OK: preview  •  OK again: fullscreen  •  Hold OK: favorite  •  BACK: home" android:textColor="#AAAAAA" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/loading" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" android:visibility="gone"/>
</FrameLayout>
