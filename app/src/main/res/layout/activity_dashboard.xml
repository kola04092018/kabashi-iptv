<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kabashi_albanian_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="165dp"
            android:layout_height="match_parent"
            android:background="#E8000000"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:contentDescription="KABASHI IPTV logo"
                android:src="@drawable/app_icon" />

            <TextView
                android:id="@+id/homeMenu"
                android:background="@drawable/sidebar_home_selector"
                android:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="12dp"
                android:text="⌂  HOME"
                android:textSize="10sp" 
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <TextView
                android:id="@+id/liveMenu"
                android:background="@drawable/sidebar_button_selector"
                android:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:text="▣  LIVE TV"
                android:textSize="10sp" 
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <TextView
                android:id="@+id/moviesMenu"
                android:background="@drawable/sidebar_button_selector"
                android:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:text="▶  MOVIES / VOD"
                android:textSize="10sp" 
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <TextView
                android:id="@+id/seriesMenu"
                android:background="@drawable/sidebar_button_selector"
                android:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:text="▤  TV SERIES"
                android:textSize="10sp" 
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <TextView
                android:id="@+id/catchupMenu"
                android:background="@drawable/sidebar_button_selector"
                android:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:text="↶  CATCH-UP"
                android:textSize="10sp" 
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <TextView
                android:id="@+id/favoritesMenu"
                android:background="@drawable/sidebar_button_selector"
                android:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:text="★  FAVORITES"
                android:textSize="10sp" 
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <TextView
                android:id="@+id/multiviewMenu"
                android:background="@drawable/sidebar_button_selector"
                android:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:text="▦  MULTIVIEW"
                android:textSize="10sp" 
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <TextView
                android:id="@+id/settingsButton"
                android:background="@drawable/sidebar_button_selector"
                android:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="5dp"
                android:text="⚙  SETTINGS"
                android:textSize="10sp" 
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/logoutButton"
                android:background="@drawable/sidebar_button_selector"
                android:backgroundTint="@null"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="LOG OUT"
                android:textSize="10sp" 
                android:gravity="center"
                android:includeFontPadding="false"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="KABASHI IPTV"
                    android:textColor="@android:color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="CREATED BY MHILL KABASHI"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/expirationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expiration: loading…"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/connectionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Loading account…"
                        android:textColor="#D0D0D0"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="225dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="LIVE TV"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/liveCard"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/dashboard_card_selector"
                                                android:clickable="true"
                        android:focusable="true"
                        android:text="REPUBLIKA E KOSOVES"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="bottom|center_horizontal"
                        android:paddingBottom="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="MOVIES / VOD"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/moviesCard"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/dashboard_card_selector"
                                                android:clickable="true"
                        android:focusable="true"
                        android:text="REPUBLIKA E KOSOVES"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="bottom|center_horizontal"
                        android:paddingBottom="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="TV SERIES"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/seriesCard"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/dashboard_card_selector"
                                                android:clickable="true"
                        android:focusable="true"
                        android:text="REPUBLIKA E KOSOVES"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="bottom|center_horizontal"
                        android:paddingBottom="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Recently Added"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/newMovies"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="2dp" />

                <TextView
                    android:id="@+id/noMovies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="No newly added movies were returned."
                    android:textColor="#D0D0D0"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
