<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <HorizontalScrollView
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:background="#D910131A"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/channelHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <Button
                android:id="@+id/liveButton"
                style="@style/KabashiButton.Primary"
                android:layout_width="112dp"
                android:layout_height="40dp"
                android:text="BACK LIVE"
                android:textSize="10sp" />

            <Button
                android:id="@+id/catchUpButton"
                style="@style/KabashiButton.Secondary"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="CATCH-UP"
                android:textSize="10sp" />

            <Button
                android:id="@+id/audioFixButton"
                style="@style/KabashiButton.Secondary"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="AUDIO FIX"
                android:textSize="10sp" />

            <Button
                android:id="@+id/subtitleButton"
                style="@style/KabashiButton.Secondary"
                android:layout_width="125dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="SUBTITLES ON"
                android:textSize="10sp" />

            <Button
                android:id="@+id/externalButton"
                style="@style/KabashiButton.Secondary"
                android:layout_width="125dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="EXTERNAL"
                android:textSize="10sp" />

            <Button
                android:id="@+id/recordButton"
                style="@style/KabashiButton.Primary"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="RECORD"
                android:textSize="10sp" />

            <Button
                android:id="@+id/stopRecordingButton"
                style="@style/KabashiButton.Secondary"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="STOP REC"
                android:textSize="10sp" />

            <Button
                android:id="@+id/pipButton"
                style="@style/KabashiButton.Secondary"
                android:layout_width="70dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="PIP"
                android:textSize="10sp" />

            <Button
                android:id="@+id/settingsButton"
                style="@style/KabashiButton.Secondary"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="SETTINGS"
                android:textSize="10sp" />
        </LinearLayout>
    </HorizontalScrollView>


    <LinearLayout
        android:id="@+id/channelInfoBar"
        android:layout_width="match_parent" android:layout_height="86dp"
        android:layout_gravity="bottom" android:background="#E80A0A0C"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="22dp" android:visibility="gone">
        <TextView android:id="@+id/infoChannelName" android:layout_width="280dp" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@android:color/white" android:textSize="19sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/infoProgramTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/infoProgramTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E94A45" android:textSize="12sp"/>
            <ProgressBar android:id="@+id/infoProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:max="100"/>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
