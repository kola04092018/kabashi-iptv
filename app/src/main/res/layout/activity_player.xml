<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="true" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_gravity="top"
        android:background="#CC10131A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/liveButton"
            style="@style/KabashiButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="BACK TO LIVE" />

        <Button
            android:id="@+id/catchUpButton"
            style="@style/KabashiButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="CATCH-UP" />

        <Button
            android:id="@+id/externalButton"
            style="@style/KabashiButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="EXTERNAL PLAYER" />

        <Button
            android:id="@+id/recordButton"
            style="@style/KabashiButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="RECORD" />

        <Button
            android:id="@+id/stopRecordingButton"
            style="@style/KabashiButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="STOP REC" />

        <Button
            android:id="@+id/pipButton"
            style="@style/KabashiButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="PIP" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
