<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#D71920" />
            <corners android:radius="8dp" />
            <stroke android:width="3dp" android:color="#FF000000" />
            <padding android:left="8dp" android:right="8dp" android:top="2dp" android:bottom="2dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#B5161C" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#FF000000" />
            <padding android:left="8dp" android:right="8dp" android:top="2dp" android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D9151515" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#663A3A3A" />
            <padding android:left="8dp" android:right="8dp" android:top="2dp" android:bottom="2dp" />
        </shape>
    </item>
</selector>
